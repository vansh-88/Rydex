// Prisma schema — source of truth for entity design is claude.md §6-13.
// Only entities whose design is already fully specified are modeled here
// (claude.md §88 Stage 2 / steps.md Phase 2). Ride, Booking, Payment, etc.
// are added when their own phases land.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// --- Enums ---

enum UserRole {
  DRIVER
  PASSENGER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum VehicleType {
  HATCHBACK
  SEDAN
  SUV
  MUV

  @@map("vehicle_type")
}

enum VehicleStatus {
  ACTIVE
  INACTIVE

  @@map("vehicle_status")
}

enum VehicleVerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("vehicle_verification_status")
}

enum VehicleDocumentType {
  RC
  INSURANCE
  POLLUTION

  @@map("vehicle_document_type")
}

// claude.md §8/§96 (2026-08-11): the only user document type defined so far
// is the driving license, submitted to become a DRIVER. Add more values here
// if/when another user document type is specified.
enum UserDocumentType {
  DRIVING_LICENSE

  @@map("user_document_type")
}

// Shared by user_documents and vehicle_documents (claude.md §13).
enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("document_status")
}

// claude.md §8/§96 (2026-08-11): decision state for a PASSENGER's request to
// become a DRIVER. NONE (never applied) is distinct from PENDING so a fresh
// user and a rejected-then-not-yet-resubmitted user aren't conflated.
enum DriverLicenseStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED

  @@map("driver_license_status")
}

// claude.md §19: PENDING_PAYMENT exists because ride creation requires the
// driver's posting commission (§30), confirmed asynchronously/webhook-driven
// (§40, Phase 10) — a ride can't become searchable (OPEN) within the same
// request that created it.
enum RideStatus {
  PENDING_PAYMENT
  OPEN
  FULL
  STARTED
  COMPLETED
  CANCELLED

  @@map("ride_status")
}

// claude.md §33. §97 (2026-08-13): §32 originally also listed a separate
// `payment_status` column alongside `booking_status`, but §33's own state
// list (PENDING_PAYMENT/PAYMENT_FAILED alongside CONFIRMED/CANCELLED/
// COMPLETED) is a single state machine, not two independent ones — and
// that's exactly the pattern Ride already settled on (one `status` column,
// no separate `payment_status`, §19). Resolved the same way: one `status`
// column here too. A Payment row's own `status` (§38) remains the source of
// truth for gateway-level payment-attempt detail.
enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  PAYMENT_FAILED
  CANCELLED
  COMPLETED

  @@map("booking_status")
}

// claude.md §38: gateway-level payment-attempt lifecycle. CREATED is set the
// moment PaymentProvider.createOrder() returns; SUCCESS/FAILED are set only
// by the webhook (§40) — frontend-reported success never sets this directly.
enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED

  @@map("payment_status")
}

// claude.md §38: business-level financial record types. Only
// DRIVER_RIDE_FEE and BOOKING_PREPAYMENT are produced starting this phase;
// FINAL_PAYMENT and REFUND are Phase 11 (Settlement) — defined now since
// the type is a fixed enum, same as RideStatus/BookingStatus already
// including values unreachable until a later phase.
enum TransactionType {
  DRIVER_RIDE_FEE
  BOOKING_PREPAYMENT
  FINAL_PAYMENT
  REFUND

  @@map("transaction_type")
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED

  @@map("transaction_status")
}

// claude.md §45: a user may have multiple devices — this is not a single
// token-per-user field on User, it's its own table.
enum DevicePlatform {
  IOS
  ANDROID
  WEB

  @@map("device_platform")
}

// Which role the *ratee* was being rated in — a passenger rating their driver
// produces DRIVER, a driver rating one of their passengers produces PASSENGER.
// Derivable from raterId, but stored so the (ratee_id, ratee_role) index is
// usable and a row reads independently, same denormalisation reasoning as
// SupportMessage.toolName.
enum RatingRole {
  DRIVER
  PASSENGER

  @@map("rating_role")
}

// claude.md §44: the fixed initial set of notification types.
enum NotificationType {
  RIDE_BOOKED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  RIDE_CANCELLED
  RIDE_STARTING
  RIDE_COMPLETED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  REFUND_PROCESSED

  @@map("notification_type")
}

// claude.md §96.5 (Phase 13.5): the AI support chatbot's own conversation
// lifecycle — distinct from BookingStatus/RideStatus. ESCALATED plus
// escalationReason/escalatedAt on SupportConversation below are the only
// concession to a future human-support handoff (claude.md §9-style
// escalation) — no ticket/queue system exists yet.
enum SupportConversationStatus {
  OPEN
  RESOLVED
  ESCALATED

  @@map("support_conversation_status")
}

// claude.md §96.5: mirrors the OpenAI/Gemini-compatible tool-calling
// message-role vocabulary directly, since that's the wire format
// AIProvider.complete() is built around. TOOL is the tool-execution
// result fed back to the model; ASSISTANT rows may carry a null `content`
// with only `toolCalls` set (a pure tool-call turn) instead of user-facing
// text.
enum SupportMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL

  @@map("support_message_role")
}

// claude.md §96.5: AI provider failures are persisted, not just thrown —
// so the conversation record shows a failed turn rather than silently
// missing one. Distinct from BookingStatus/PaymentStatus's richer state
// machines: this is just "did this one turn's provider call succeed."
enum SupportMessageStatus {
  COMPLETED
  FAILED

  @@map("support_message_status")
}

// --- Models ---

// claude.md §47 (Phase 13): one conversation per (ride, passenger) pair —
// the driver talks to each passenger separately, not one shared ride-wide
// room. driverId is denormalized from ride.driverId at creation time so a
// socket-join authorization check never needs to join through Ride (a stale
// copy is fine: a ride's driver never changes after creation, claude.md §15
// has no reassign-driver flow).
model Conversation {
  id          String   @id @default(uuid()) @db.Uuid
  rideId      String   @map("ride_id") @db.Uuid
  driverId    String   @map("driver_id") @db.Uuid
  passengerId String   @map("passenger_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ride      Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver    User      @relation("ConversationDriver", fields: [driverId], references: [id], onDelete: Cascade)
  passenger User      @relation("ConversationPassenger", fields: [passengerId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([rideId, passengerId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  message        String
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  phone           String     @unique
  name            String
  profileImageUrl String?    @map("profile_image_url")
  role            UserRole
  status          UserStatus @default(ACTIVE)

  // Reputation is role-scoped: a single average cannot mean both "good driver"
  // and "good passenger", and the fare multiplier (§29) and DRIVER_RATING
  // search sort (§25) must read the driver figure specifically. Nullable
  // averages mean "no ratings yet", distinct from a low score — search sorts
  // unrated drivers last via COALESCE rather than treating them as bad.
  driverRatingAverage    Decimal? @map("driver_rating_average") @db.Decimal(3, 2)
  driverRatingCount      Int      @default(0) @map("driver_rating_count")
  passengerRatingAverage Decimal? @map("passenger_rating_average") @db.Decimal(3, 2)
  passengerRatingCount   Int      @default(0) @map("passenger_rating_count")

  // claude.md §8/§96 (2026-08-11): how a PASSENGER becomes a DRIVER. The
  // license file itself is a UserDocument (documentType = DRIVING_LICENSE);
  // these fields hold the admin's decision, mirroring Vehicle's
  // verificationStatus/verifiedBy/verifiedAt/rejectionReason below. Approval
  // sets role -> DRIVER in the same transaction as this status -> VERIFIED.
  driverLicenseStatus          DriverLicenseStatus @default(NONE) @map("driver_license_status")
  driverLicenseVerifiedById    String?             @map("driver_license_verified_by") @db.Uuid
  driverLicenseVerifiedAt      DateTime?           @map("driver_license_verified_at") @db.Timestamptz(3)
  driverLicenseRejectionReason String?             @map("driver_license_rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens            RefreshToken[]
  documents                UserDocument[]
  vehicles                 Vehicle[]             @relation("VehicleOwner")
  verifiedVehicles         Vehicle[]             @relation("VehicleVerifiedBy")
  driverLicenseVerifiedBy  User?                 @relation("DriverLicenseVerifiedBy", fields: [driverLicenseVerifiedById], references: [id], onDelete: SetNull)
  verifiedDriverLicenses   User[]                @relation("DriverLicenseVerifiedBy")
  ridesDriven              Ride[]                @relation("RideDriver")
  bookings                 Booking[]
  payments                 Payment[]
  transactions             Transaction[]
  idempotencyKeys          IdempotencyKey[]
  devices                  UserDevice[]
  notifications            Notification[]
  conversationsAsDriver    Conversation[]        @relation("ConversationDriver")
  conversationsAsPassenger Conversation[]        @relation("ConversationPassenger")
  messages                 Message[]
  supportConversations     SupportConversation[]
  ratingsGiven             Rating[]              @relation("RatingRater")
  ratingsReceived          Rating[]              @relation("RatingRatee")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  deviceId  String?   @map("device_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model UserDocument {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  documentType       UserDocumentType @map("document_type")
  cloudinaryPublicId String           @map("cloudinary_public_id")
  secureUrl          String           @map("secure_url")
  status             DocumentStatus   @default(PENDING)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_documents")
}

model Vehicle {
  id                 String      @id @default(uuid()) @db.Uuid
  ownerId            String      @map("owner_id") @db.Uuid
  registrationNumber String      @unique @map("registration_number")
  make               String
  model              String
  variant            String?
  color              String?
  seatCapacity       Int         @map("seat_capacity")
  vehicleType        VehicleType @map("vehicle_type")
  isAc               Boolean     @default(false) @map("is_ac")
  isAcWorking        Boolean?    @map("is_ac_working")

  // claude.md §8/§96/§97 (2026-08-11): VERIFIED gates ride creation.
  // verifiedBy/verifiedAt/rejectionReason are set by the Admin module.
  verificationStatus VehicleVerificationStatus @default(PENDING) @map("verification_status")
  verifiedById       String?                   @map("verified_by") @db.Uuid
  verifiedAt         DateTime?                 @map("verified_at") @db.Timestamptz(3)
  rejectionReason    String?                   @map("rejection_reason")

  status    VehicleStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner      User              @relation("VehicleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  verifiedBy User?             @relation("VehicleVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  documents  VehicleDocument[]
  rides      Ride[]

  @@index([ownerId])
  @@map("vehicles")
}

model VehicleDocument {
  id                 String              @id @default(uuid()) @db.Uuid
  vehicleId          String              @map("vehicle_id") @db.Uuid
  documentType       VehicleDocumentType @map("document_type")
  cloudinaryPublicId String              @map("cloudinary_public_id")
  secureUrl          String              @map("secure_url")
  status             DocumentStatus      @default(PENDING)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_documents")
}

// claude.md §15/§16/§18. origin/destination are `Unsupported` because Prisma
// Client has no native geography type — the ride repository reads/writes
// them via raw SQL (claude.md §77) using ST_MakePoint/ST_X/ST_Y. Every other
// column is normal Prisma Client access. GiST indexes on origin/destination
// are added by hand in the migration SQL (Prisma can't declare @@index on an
// Unsupported field) — see claude.md §16.
model Ride {
  id        String @id @default(uuid()) @db.Uuid
  driverId  String @map("driver_id") @db.Uuid
  vehicleId String @map("vehicle_id") @db.Uuid

  origin      Unsupported("geography(Point,4326)")
  destination Unsupported("geography(Point,4326)")

  // Free-text labels for display only — never used in distance/route math.
  originAddress      String? @map("origin_address")
  destinationAddress String? @map("destination_address")

  departureTime DateTime @map("departure_time") @db.Timestamptz(3)

  availableSeats Int @map("available_seats")
  totalSeats     Int @map("total_seats")

  // §29: fare is calculated once at creation and persisted — never
  // recalculated from current pricing configuration.
  farePerSeat Decimal @map("fare_per_seat") @db.Decimal(10, 2)

  distanceMeters  Int    @map("distance_meters")
  durationSeconds Int    @map("duration_seconds")
  // Raw GeoJSON geometry from the MapProvider, stored as-is (opaque to SQL).
  routeGeometry   String @map("route_geometry")

  // §30: driver's 5% posting commission, calculated once and persisted.
  // §37/§97 (2026-08-12): no real Payment/Transaction table exists yet
  // (Phase 10) — orderId is the provider's reference so Phase 10's webhook
  // can find this ride when the stub PaymentProvider is replaced with Razorpay.
  postingCommissionAmount  Decimal @map("posting_commission_amount") @db.Decimal(10, 2)
  postingCommissionOrderId String  @map("posting_commission_order_id")

  status RideStatus @default(PENDING_PAYMENT)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  driver        User           @relation("RideDriver", fields: [driverId], references: [id], onDelete: Cascade)
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  bookings      Booking[]
  payments      Payment[]
  transactions  Transaction[]
  conversations Conversation[]
  ratings       Rating[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([departureTime, status])
  @@map("rides")
}

// claude.md §32/§35/§36. No PostGIS geography here — unlike Ride,
// pickup/drop have no ST_DWithin/ST_Distance query requirement in this
// phase (they're informational, defaulting to the ride's own origin/
// destination), so plain lat/lng columns avoid the Unsupported-type/raw-SQL
// machinery Ride needed for a real reason (search, §20-§23).
model Booking {
  id          String @id @default(uuid()) @db.Uuid
  rideId      String @map("ride_id") @db.Uuid
  passengerId String @map("passenger_id") @db.Uuid

  seatCount Int @map("seat_count")

  pickupLat Float @map("pickup_lat")
  pickupLng Float @map("pickup_lng")
  dropLat   Float @map("drop_lat")
  dropLng   Float @map("drop_lng")

  // §41/§84: locked at booking creation from the ride's own farePerSeat,
  // never recalculated later.
  farePerSeat   Decimal @map("fare_per_seat") @db.Decimal(10, 2)
  totalFare     Decimal @map("total_fare") @db.Decimal(10, 2)
  // §34: 10% of totalFare, paid upfront.
  prepaidAmount Decimal @map("prepaid_amount") @db.Decimal(10, 2)

  // Mirrors Ride's postingCommissionOrderId (§97 2026-08-12): set right
  // after the booking row is created (payment-order creation is an
  // external call, kept out of the seat-reservation transaction, §5.5), so
  // nullable until that follow-up write lands.
  prepaymentOrderId String? @map("prepayment_order_id")

  // claude.md §41 (Phase 11): set when the ride completes and the remaining
  // 90% payment order is created for this booking (finalPaymentService,
  // same "external call, then follow-up write" pattern as prepaymentOrderId
  // above). Null until then; also null for bookings that never reach
  // CONFIRMED (nothing to collect a final payment for).
  finalPaymentOrderId String? @map("final_payment_order_id")

  status BookingStatus @default(PENDING_PAYMENT)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ride         Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passenger    User          @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  payments     Payment[]
  transactions Transaction[]
  ratings      Rating[]

  @@index([rideId])
  @@index([passengerId])
  @@map("bookings")
}

// A rating is scoped to one booking, which is what makes "one rating per
// participant per shared trip" expressible as a uniqueness constraint. Both
// directions live in this one table: a passenger rating their driver and that
// driver rating the passenger are two rows on the same booking with swapped
// rater/ratee and different rateeRole.
//
// Ratings are immutable — there is no update or delete path. The aggregate on
// `users` is maintained incrementally (ratingRepository.applyToAggregate), so
// mutating a score after the fact would require recomputing it, and no
// requirement asks for that.
model Rating {
  id        String     @id @default(uuid()) @db.Uuid
  rideId    String     @map("ride_id") @db.Uuid
  bookingId String     @map("booking_id") @db.Uuid
  raterId   String     @map("rater_id") @db.Uuid
  rateeId   String     @map("ratee_id") @db.Uuid
  rateeRole RatingRole @map("ratee_role")

  // 1-5, validated in Zod rather than by a DB CHECK — same reasoning as
  // Payment's ride/booking exclusivity: Prisma doesn't model arbitrary CHECK
  // constraints declaratively.
  score   Int
  comment String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ride    Ride    @relation(fields: [rideId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rater   User    @relation("RatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  ratee   User    @relation("RatingRatee", fields: [rateeId], references: [id], onDelete: Cascade)

  // Load-bearing: this is what makes double-rating impossible, and it is the
  // database (not an application pre-check) that arbitrates two concurrent
  // submissions — same pattern as idempotency_keys (user_id, key).
  @@unique([bookingId, raterId])
  @@index([rateeId, rateeRole])
  @@map("ratings")
}

// claude.md §38: gateway-level payment attempt. Exactly one of
// rideId/bookingId is set (a driver posting-fee payment vs a passenger
// prepayment/final-payment) — enforced in application code, not a DB CHECK
// constraint (Prisma doesn't model arbitrary CHECK constraints declaratively
// and this isn't worth a hand-written migration addition for now).
model Payment {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  bookingId String? @map("booking_id") @db.Uuid
  rideId    String? @map("ride_id") @db.Uuid

  provider          String
  providerOrderId   String  @unique @map("provider_order_id")
  providerPaymentId String? @map("provider_payment_id")

  amount   Decimal @db.Decimal(10, 2)
  currency String

  status PaymentStatus @default(CREATED)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  ride    Ride?    @relation(fields: [rideId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([providerPaymentId])
  @@map("payments")
}

// claude.md §38: business-level financial history/reconciliation record —
// "not a wallet." Created alongside its Payment row (§97 2026-08-13) so
// failed attempts are recorded too, not just successes.
model Transaction {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  bookingId String? @map("booking_id") @db.Uuid
  rideId    String? @map("ride_id") @db.Uuid

  type   TransactionType
  amount Decimal         @db.Decimal(10, 2)

  provider          String
  providerReference String? @map("provider_reference")

  status TransactionStatus

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  ride    Ride?    @relation(fields: [rideId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("transactions")
}

// claude.md §39. Unique on (userId, key) is what makes the claim step
// (idempotencyService.claim, an INSERT ... ON CONFLICT DO NOTHING) atomic —
// two concurrent requests with the same key can't both "win".
model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String
  endpoint       String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("idempotency_keys")
}

// claude.md §45. `deviceToken` is globally unique rather than
// (userId, deviceToken) — a real device/app-install's FCM token is a single
// physical identity; if a different account logs in on the same device, the
// token is reassigned to that user (upsert-by-token, never two rows racing
// to own the same token).
model UserDevice {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  deviceToken String         @unique @map("device_token")
  platform    DevicePlatform
  lastSeenAt  DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}

// claude.md §46: in-app notification history — a separate concern from FCM
// delivery (a push-delivery failure must never prevent this row from
// existing, and vice versa).
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// claude.md §96.5 (Phase 13.5): the AI support chatbot's own conversation —
// distinct from Conversation/Message above, which remain the
// passenger-driver chat (§47). No ride/booking FK: a support conversation
// is scoped to a user, not tied to any single ride.
model SupportConversation {
  id     String                    @id @default(uuid()) @db.Uuid
  userId String                    @map("user_id") @db.Uuid
  status SupportConversationStatus @default(OPEN)

  // Nullable — only ever set if/when a future human-escalation flow sets
  // status -> ESCALATED. No ticket/case table exists yet (claude.md §6/§96.5).
  escalationReason String?   @map("escalation_reason")
  escalatedAt      DateTime? @map("escalated_at") @db.Timestamptz(3)

  lastMessageAt DateTime @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId, lastMessageAt])
  @@map("support_conversations")
}

// claude.md §96.5: one row per turn in the tool-calling loop — a single
// user message can produce an ASSISTANT row with only `toolCalls` set (no
// user-facing text yet), one or more TOOL rows with the executed results,
// and a final ASSISTANT row with `content` set. No senderId/userId column
// (unlike Message) — role already distinguishes USER from ASSISTANT/TOOL,
// and every row's actor is either "the user" or "the model", never
// ambiguous within a single-user conversation.
model SupportMessage {
  id             String             @id @default(uuid()) @db.Uuid
  conversationId String             @map("conversation_id") @db.Uuid
  role           SupportMessageRole

  content String?

  // Set on a TOOL-role row: which of the assistant's requested calls this
  // result answers, and the tool's name (denormalized for readability —
  // the id alone would require joining back to the ASSISTANT row's
  // toolCalls JSON to know which function ran).
  toolCallId    String? @map("tool_call_id")
  toolName      String? @map("tool_name")
  // Denormalized from the assistant's toolCalls[i].arguments so a TOOL row
  // is independently readable without joining back to the ASSISTANT row.
  toolArguments Json?   @map("tool_arguments")
  // Set on an ASSISTANT-role row that requests one or more tool calls —
  // never includes a userId/identity field (claude.md §96.5: the model's
  // only degree of freedom is which tool + which resource id).
  toolCalls     Json?   @map("tool_calls")

  provider         String?
  model            String?
  promptTokens     Int?    @map("prompt_tokens")
  completionTokens Int?    @map("completion_tokens")

  status    SupportMessageStatus @default(COMPLETED)
  errorCode String?              @map("error_code")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("support_messages")
}
