# Applies repo-wide (monorepo: backend/, and later frontend/) — none of
# these patterns contain an internal slash, so git matches them at any depth.
node_modules/
dist/
coverage/

.env
.env.local
.env.*.local

*.log
npm-debug.log*

.DS_Store

# Backend-specific: generated Prisma client. Root-anchored on purpose —
# unlike the patterns above, this one only exists under backend/.
backend/src/generated/prisma
