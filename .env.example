# Copy to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000

# Trust X-Forwarded-For when resolving the client IP (claude.md §49/§65).
# Accepts only "true" or "false" — anything else fails startup rather than
# being silently misread.
#
# MUST stay false until a load balancer that overwrites X-Forwarded-For sits
# in front of the app (Phase 16's ALB). With no proxy, trusting the header
# lets any client spoof it and get a fresh rate-limit bucket per request,
# which defeats the OTP brute-force protection entirely. Flip to true in the
# same change that puts the app behind the load balancer.
TRUST_PROXY=false

# --- Database (docker-compose defaults) ---
DATABASE_URL=postgresql://rydex:rydex@localhost:5432/rydex?schema=public

# --- Redis (docker-compose defaults) ---
REDIS_URL=redis://localhost:6379

# --- Auth (must be >= 32 chars) ---
JWT_ACCESS_SECRET=changeme-access-secret-please-use-something-random
JWT_REFRESH_SECRET=changeme-refresh-secret-please-use-something-random

# --- Brevo (OTP email) — leave blank to use the console dev fallback, which
# logs the OTP instead of emailing it (infrastructure/email). The fallback is
# refused when NODE_ENV=production.
# BREVO_API_KEY must be an "API key" (xkeysib-…) from Brevo → SMTP & API → API
# keys. An SMTP key (xsmtpsib-…) will NOT work: the REST API rejects it with 401.
# BREVO_FROM_EMAIL must be verified under Senders, Domains & Dedicated IPs. ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Rydex

# --- OTP (claude.md §9) ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_IP_MAX=10
OTP_REQUEST_IP_WINDOW_SECONDS=3600
OTP_VERIFY_IP_MAX=20
OTP_VERIFY_IP_WINDOW_SECONDS=3600

# --- Rate limits (claude.md §49/§50) — per authenticated user unless the
# name says IP. See src/config/env.ts for why each limit is what it is. ---
AUTH_REFRESH_IP_MAX=60
AUTH_REFRESH_IP_WINDOW_SECONDS=3600
RIDE_SEARCH_RATE_LIMIT_MAX=60
RIDE_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
RIDE_CREATE_RATE_LIMIT_MAX=10
RIDE_CREATE_RATE_LIMIT_WINDOW_SECONDS=3600
BOOKING_CREATE_RATE_LIMIT_MAX=20
BOOKING_CREATE_RATE_LIMIT_WINDOW_SECONDS=3600
AUTHENTICATED_READ_RATE_LIMIT_MAX=300
AUTHENTICATED_READ_RATE_LIMIT_WINDOW_SECONDS=60
DOCUMENT_UPLOAD_RATE_LIMIT_MAX=20
DOCUMENT_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
# High on purpose: a DoS ceiling only. Dropping a real Razorpay retry burst
# is far worse than absorbing it.
WEBHOOK_IP_MAX=1000
WEBHOOK_IP_WINDOW_SECONDS=60
WS_CONNECT_RATE_LIMIT_MAX=30
WS_CONNECT_RATE_LIMIT_WINDOW_SECONDS=60
WS_MESSAGE_RATE_LIMIT_MAX=60
WS_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60

# --- Cloudinary (documents / images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- FCM (push notifications). Leave blank (or set an invalid key) to use
# ConsolePushProvider for local dev (claude.md §42/Phase 12) — no real push
# notifications sent, notifications still persist normally for the in-app
# notification center. FCM_PRIVATE_KEY must be a full PEM key (the
# service-account JSON's "private_key" field, with real newlines or "\n"
# escapes — either works, both are normalized). ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Payment provider (Razorpay). Leave PAYMENT_PROVIDER_KEY/SECRET blank to
# use StubPaymentProvider for local dev (claude.md §37/§97) — no real
# gateway calls, no real charges. PAYMENT_PROVIDER_WEBHOOK_SECRET is
# required either way: it's used to sign/verify simulated webhooks locally
# even in stub mode, so pick any local secret string when testing. ---
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_PROVIDER_WEBHOOK_SECRET=changeme-webhook-secret-please-use-something-random

# --- Idempotency (claude.md §39) ---
IDEMPOTENCY_KEY_TTL_HOURS=24

# --- Map provider (Geoapify — no-card-required free tier; see claude.md
# §97 Architecture Change Log for why this replaces the originally-named
# Mapbox). Sign up at geoapify.com, no payment method required. ---
MAP_PROVIDER=geoapify
MAP_PROVIDER_API_KEY=

# --- AI support chatbot (Gemini initial provider; claude.md §96.5 —
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
SUPPORT_CHAT_MAX_MESSAGE_LENGTH=2000
SUPPORT_CHAT_MAX_HISTORY_MESSAGES=20
SUPPORT_CHAT_PROVIDER_TIMEOUT_MS=15000
SUPPORT_CHAT_MAX_TOOL_ROUNDS=2
SUPPORT_CHAT_RATE_LIMIT_MAX=10
SUPPORT_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
SUPPORT_CHAT_DAILY_MESSAGE_LIMIT=50

# --- Ride search (claude.md §20, §26, §85) ---
RIDE_ORIGIN_MATCH_RADIUS_METERS=10000
RIDE_DESTINATION_MATCH_RADIUS_METERS=10000
RIDE_SEARCH_DEFAULT_LIMIT=20
RIDE_SEARCH_MAX_LIMIT=50

# --- Business rules (claude.md §85) ---
DRIVER_COMMISSION_PERCENT=5
PASSENGER_PREPAYMENT_PERCENT=10
FINAL_PAYMENT_PERCENT=90
PLATFORM_COMMISSION_PERCENT=3
DRIVER_EARLY_CANCEL_REFUND_PERCENT=2
DRIVER_CANCEL_THRESHOLD_HOURS=18

# --- Fare heuristic (claude.md §29) ---
FARE_BASE_FARE=30
FARE_PRICE_PER_KM=8
FARE_VEHICLE_MULTIPLIER_HATCHBACK=1.0
FARE_VEHICLE_MULTIPLIER_SEDAN=1.15
FARE_VEHICLE_MULTIPLIER_SUV=1.35
FARE_VEHICLE_MULTIPLIER_MUV=1.3
FARE_TRAFFIC_MULTIPLIER_MIN=0.8
FARE_TRAFFIC_MULTIPLIER_MAX=2.0
FARE_RATING_MULTIPLIER_MIN=0.95
FARE_RATING_MULTIPLIER_MAX=1.05

# --- Booking seat-hold expiry (claude.md §35/§36) ---
BOOKING_PAYMENT_TTL_SECONDS=900
