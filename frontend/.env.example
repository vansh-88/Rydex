# Copy to .env.local (gitignored) and fill in.

# Where the API lives.
#
# Leave EMPTY for local development: the Vite dev server proxies /api and
# /socket.io to VITE_API_PROXY_TARGET below, which keeps everything same-origin
# and means CORS never applies.
#
# Set it in a DEPLOYED build to the backend's origin (no trailing slash), e.g.
#   VITE_API_BASE_URL=https://rydex-4efi.onrender.com
# The backend's CORS_ORIGIN must then name this app's own origin, or every
# request is blocked.
VITE_API_BASE_URL=

# Dev only — the proxy target. Ignored in a deployed build.
# Local backend (docker compose up -d in ../backend, then npm run dev there):
VITE_API_PROXY_TARGET=http://localhost:4000
# Deployed backend instead — note Render's free tier cold-starts (~30s):
# VITE_API_PROXY_TARGET=https://rydex-4efi.onrender.com

# Razorpay Checkout needs the publishable key id client-side. This is the
# public half of the pair and is safe in the browser — it only identifies the
# merchant. The secret stays on the backend and is never sent here.
# Must match the backend's PAYMENT_PROVIDER_KEY or Checkout cannot find the
# order, and must be the TEST key while the backend runs with test credentials.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Geoapify key used only for map tiles on the two read-only route views.
# Place autocomplete does NOT use this — it goes through the backend proxy at
# GET /api/v1/places/autocomplete so the provider key stays server-side.
# Optional: falls back to OpenStreetMap tiles when unset.
VITE_GEOAPIFY_TILE_KEY=
