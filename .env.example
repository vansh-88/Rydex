# Copy to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Database (docker-compose defaults) ---
DATABASE_URL=postgresql://rydex:rydex@localhost:5432/rydex?schema=public

# --- Redis (docker-compose defaults) ---
REDIS_URL=redis://localhost:6379

# --- Auth (must be >= 32 chars) ---
JWT_ACCESS_SECRET=changeme-access-secret-please-use-something-random
JWT_REFRESH_SECRET=changeme-refresh-secret-please-use-something-random

# --- Resend (OTP email) — leave blank to use the console dev fallback,
# which logs the OTP instead of emailing it (infrastructure/resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- OTP (claude.md §9) ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_IP_MAX=10
OTP_REQUEST_IP_WINDOW_SECONDS=3600
OTP_VERIFY_IP_MAX=20
OTP_VERIFY_IP_WINDOW_SECONDS=3600

# --- Cloudinary (documents / images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- FCM (push notifications) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Payment provider (Razorpay) ---
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# --- Map provider (Geoapify — no-card-required free tier; see claude.md
# §97 Architecture Change Log for why this replaces the originally-named
# Mapbox). Sign up at geoapify.com, no payment method required. ---
MAP_PROVIDER=geoapify
MAP_PROVIDER_API_KEY=

# --- Ride search (claude.md §20, §26, §85) ---
RIDE_ORIGIN_MATCH_RADIUS_METERS=10000
RIDE_DESTINATION_MATCH_RADIUS_METERS=10000
RIDE_SEARCH_DEFAULT_LIMIT=20
RIDE_SEARCH_MAX_LIMIT=50

# --- Business rules (claude.md §85) ---
DRIVER_COMMISSION_PERCENT=5
PASSENGER_PREPAYMENT_PERCENT=10
FINAL_PAYMENT_PERCENT=90
PLATFORM_COMMISSION_PERCENT=3
DRIVER_EARLY_CANCEL_REFUND_PERCENT=2
DRIVER_CANCEL_THRESHOLD_HOURS=18

# --- Fare heuristic (claude.md §29) ---
FARE_BASE_FARE=30
FARE_PRICE_PER_KM=8
FARE_VEHICLE_MULTIPLIER_HATCHBACK=1.0
FARE_VEHICLE_MULTIPLIER_SEDAN=1.15
FARE_VEHICLE_MULTIPLIER_SUV=1.35
FARE_VEHICLE_MULTIPLIER_MUV=1.3
FARE_TRAFFIC_MULTIPLIER_MIN=0.8
FARE_TRAFFIC_MULTIPLIER_MAX=2.0
FARE_RATING_MULTIPLIER_MIN=0.95
FARE_RATING_MULTIPLIER_MAX=1.05
